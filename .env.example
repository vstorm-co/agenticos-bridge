BRIDGE_PUBLIC_URL=https://bridge-agenticos.testapp.ovh
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
BRIDGE_TICKET_KEY=
# JSON exact origins, never callback URLs. Empty rejects all starts.
# "*" explicitly opens enrollment to all HTTPS self-hosted AgenticOS origins.
BRIDGE_ALLOWED_ORIGINS=["http://localhost:3000"]
BRIDGE_GOOGLE_CLIENT_ID=
BRIDGE_GOOGLE_CLIENT_SECRET=
BRIDGE_MICROSOFT_CLIENT_ID=
BRIDGE_MICROSOFT_CLIENT_SECRET=
BRIDGE_SLACK_CLIENT_ID=
BRIDGE_SLACK_CLIENT_SECRET=
